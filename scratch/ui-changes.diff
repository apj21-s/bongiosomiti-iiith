diff --git a/album-align-calibrator.html b/album-align-calibrator.html
new file mode 100644
index 0000000..3d3cca0
--- /dev/null
+++ b/album-align-calibrator.html
@@ -0,0 +1,821 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>Album Image Fit, Title & Alignment Calibrator</title>
+  <link rel="icon" type="image/png" sizes="16x16" href="assets/logo.png" />
+  <link rel="icon" type="image/png" sizes="32x32" href="assets/logo.png" />
+  <link rel="icon" type="image/png" sizes="48x48" href="assets/logo.png" />
+  <link rel="apple-touch-icon" sizes="180x180" href="assets/logo.png" />
+  <link rel="icon" type="image/png" sizes="192x192" href="assets/logo.png" />
+  <style>
+    * { margin: 0; padding: 0; box-sizing: border-box; }
+
+    body {
+      font-family: 'Inter', system-ui, -apple-system, sans-serif;
+      background: #120a05;
+      color: #f5e9da;
+      height: 100vh;
+      display: flex;
+      flex-direction: column;
+      overflow: hidden;
+    }
+
+    header {
+      background: #1e1209;
+      border-bottom: 1px solid rgba(184, 122, 75, 0.25);
+      padding: 14px 24px;
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      flex-shrink: 0;
+    }
+
+    .brand {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+    }
+
+    .brand h1 {
+      font-size: 1.15rem;
+      font-weight: 700;
+      color: #ffd89b;
+      letter-spacing: 0.02em;
+    }
+
+    .brand span {
+      font-size: 0.72rem;
+      background: rgba(184, 122, 75, 0.2);
+      border: 1px solid rgba(184, 122, 75, 0.4);
+      color: #df9e6d;
+      padding: 2px 8px;
+      border-radius: 4px;
+      font-weight: 600;
+    }
+
+    .app-layout {
+      display: flex;
+      flex: 1;
+      overflow: hidden;
+    }
+
+    /* Left Sidebar: Photo Selector */
+    .sidebar {
+      width: 320px;
+      background: #180e07;
+      border-right: 1px solid rgba(184, 122, 75, 0.2);
+      display: flex;
+      flex-direction: column;
+      flex-shrink: 0;
+    }
+
+    .sidebar-header {
+      padding: 14px 16px;
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 0.08em;
+      text-transform: uppercase;
+      color: #a3724c;
+      border-bottom: 1px solid rgba(184, 122, 75, 0.15);
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+    }
+
+    .photo-list {
+      flex: 1;
+      overflow-y: auto;
+      padding: 10px;
+      display: flex;
+      flex-direction: column;
+      gap: 8px;
+    }
+
+    .photo-item {
+      display: flex;
+      align-items: center;
+      gap: 8px;
+      padding: 8px;
+      background: rgba(255, 255, 255, 0.03);
+      border: 1px solid transparent;
+      border-radius: 6px;
+      cursor: grab;
+      transition: all 0.18s ease;
+      user-select: none;
+    }
+
+    .photo-item:active {
+      cursor: grabbing;
+    }
+
+    .photo-item:hover {
+      background: rgba(184, 122, 75, 0.12);
+      border-color: rgba(184, 122, 75, 0.3);
+    }
+
+    .photo-item.is-selected {
+      background: rgba(107, 27, 16, 0.4);
+      border-color: #b85c26;
+      box-shadow: 0 2px 8px rgba(0,0,0,0.3);
+    }
+
+    .photo-item.is-dragging {
+      opacity: 0.35;
+      border: 1px dashed #b85c26;
+      background: rgba(184, 92, 38, 0.15);
+    }
+
+    .photo-item.drag-over {
+      border-top: 2.5px solid #f5af2d;
+      background: rgba(245, 175, 45, 0.15);
+    }
+
+    .drag-handle {
+      color: #7c4a1e;
+      font-size: 1.05rem;
+      cursor: grab;
+      padding: 0 2px;
+      line-height: 1;
+      font-weight: 700;
+      letter-spacing: -1px;
+    }
+
+    .photo-item:hover .drag-handle {
+      color: #f5af2d;
+    }
+
+    .photo-item img {
+      width: 52px;
+      height: 52px;
+      object-fit: cover;
+      border-radius: 4px;
+      border: 1px solid rgba(255, 255, 255, 0.1);
+      flex-shrink: 0;
+    }
+
+    .photo-item__info {
+      flex: 1;
+      overflow: hidden;
+    }
+
+    .photo-item__title {
+      font-family: 'Noto Serif Bengali', serif;
+      font-size: 0.82rem;
+      font-weight: 700;
+      color: #f5e9da;
+      white-space: nowrap;
+      overflow: hidden;
+      text-overflow: ellipsis;
+    }
+
+    .photo-item__sub {
+      font-size: 0.68rem;
+      color: #9c7353;
+      margin-top: 2px;
+    }
+
+    /* Center Stage: Workspace / Preview */
+    .workspace {
+      flex: 1;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      justify-content: center;
+      padding: 24px;
+      background: #0d0703;
+      position: relative;
+      overflow-y: auto;
+    }
+
+    .preview-container {
+      position: relative;
+      width: 100%;
+      max-width: 780px;
+      aspect-ratio: 16 / 10;
+      background: #180e07;
+      border: 2px dashed rgba(184, 122, 75, 0.4);
+      border-radius: 12px;
+      overflow: hidden;
+      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6);
+    }
+
+    .preview-img {
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+      object-position: 50% 50%;
+      display: block;
+      transition: object-position 0.05s ease, transform 0.05s ease;
+    }
+
+    .preview-badge {
+      position: absolute;
+      bottom: 16px;
+      left: 16px;
+      background: rgba(18, 10, 4, 0.85);
