# Copy to .env.local and fill in. Never commit .env.local.
# Every variable is documented in README.md.

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
# Server-only. Bypasses row-level security - never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx

# --- Sessions -------------------------------------------------------------
# Signs admin session cookies. If unset it falls back to the service-role key,
# which means rotating that key signs every admin out. Set it explicitly:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Admin sign-in --------------------------------------------------------
# REQUIRED IN PRODUCTION. Without these, the defaults in
# utils/auth/admin-roles.ts apply - and they are public in this repository.
TIER1_EMAIL=gate@example.com
TIER1_PASSWORD=
TIER2_EMAIL=manager@example.com
TIER2_PASSWORD=
TIER3_EMAIL=admin@example.com
TIER3_PASSWORD=

# --- Email ----------------------------------------------------------------
# Without SMTP_USER/SMTP_PASS the app logs a warning and skips sending, so
# registration appears to succeed while no pass is delivered.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# --- Misc -----------------------------------------------------------------
# Absolute links in emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to True to run against the local mock store instead of Supabase.
DUMMY_DB=
