# Copy to .env.local and fill in. Never commit .env.local.
# Every variable is documented in README.md.

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
# Server-only. Bypasses row-level security - never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx

# --- Sessions -------------------------------------------------------------
# Signs admin session cookies. If unset it falls back to the service-role key,
# which means rotating that key signs every admin out. Changing it signs
# everyone out too, which is what you want when rotating. Set it explicitly:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Admin sign-in --------------------------------------------------------
# REQUIRED. There are no defaults any more: a tier with no email and password
# set has no account, and with none of the three set nobody can sign in at all.
# Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
# Tier 1 is the gate credential, shared by the gate staff. Tier 3 is the super
# admin. There is no tier-2 pair: a manager is created by the super admin at
# /admin/managers, with their own password and their own UPI id, and a shared
# manager login could not be scoped to anybody's takings.
TIER1_EMAIL=gate@example.com
TIER1_PASSWORD=
TIER3_EMAIL=admin@example.com
TIER3_PASSWORD=

# --- Shared data ----------------------------------------------------------
# Every deployment pointed at one Supabase project shares the events table,
# while public/data/events.json is per branch. Only the deployment that owns
# those rows sets this; everywhere else, opening or editing an event stays in
# that deployment's own JSON and cannot reach the live site.
#   production/main: EVENTS_DB_WRITES=true
#   dev, previews, local: leave it unset
EVENTS_DB_WRITES=

# --- Email ----------------------------------------------------------------
# REQUIRED. Registration sends a one-time code to the address given and refuses
# the registration when it cannot send (app/api/verify-email), so with these
# blank nobody can register at all. That is deliberate - an address that cannot
# be reached must not become a ticket - but it puts mail on the critical path.
#
# Any SMTP provider works; only these four values change. Port 587 is treated
# as STARTTLS and anything else as implicit TLS (see utils/email.ts).
#
# Check whatever you set with:  node scripts/check-smtp.js you@example.com
#
#   Brevo (free 300/day, no domain needed, verify a single sender address)
#     SMTP_HOST=smtp-relay.brevo.com   SMTP_PORT=587
#     SMTP_USER=<the login on the SMTP & API page, not your sign-in email>
#     SMTP_PASS=<SMTP key>
#
#   Mailjet (free 200/day)
#     SMTP_HOST=in-v3.mailjet.com      SMTP_PORT=587
#     SMTP_USER=<API key>              SMTP_PASS=<secret key>
#
#   Gmail - needs a 16-character App Password, which requires 2-Step
#   Verification. Accounts supervised by Family Link cannot create one, so
#   Gmail is not an option for those; use a relay above instead.
#     SMTP_HOST=smtp.gmail.com         SMTP_PORT=465
#
#   A domain mailbox (Hostinger and similar)
#     SMTP_HOST=smtp.hostinger.com     SMTP_PORT=465
#     SMTP_USER=<the full mailbox address>
#
# dotenv stops reading a value at an unquoted '#' and expands '$'. If the
# password contains either, wrap it in single quotes:  SMTP_PASS='a#b$c'
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# What recipients see in the From line; defaults to SMTP_USER. Most providers
# reject or spam-file a From that is not a sender you have verified with them.
FROM_EMAIL=

# --- Misc -----------------------------------------------------------------
# Absolute links in emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to True to run against the local mock store instead of Supabase.
DUMMY_DB=
